# пакеты версий клиента на диске сервера (автообновление)
releases/

# базы данных и их копии (данные клуба, ключи ПК)
*.db
*.db.bak*
*.sqlite3

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# .NET: сборка и публикация (пересобирается командой dotnet build / deploy\publish.ps1)
bin/
obj/
client/dist/

# C++: сборка нативной части (CMake) и готовая DLL (собирается скриптом client/ClubOS.Native/build.ps1)
client/ClubOS.Native/build/
client/ClubOS.Native/out/
.vs/

# настройки с ключами ПК и локальные секреты
agent.json
*.pem
# открытый ключ подписи версий вшивается в службу: он не секрет и нужен для сборки
!client/ClubOS.Service/release-public-key.pem
.env
.env.*

# временное
*.log
*.tmp

# закрытые ключи подписи версий клиента: хранить отдельно от репозитория
*.key
!deploy/server/.env.example
