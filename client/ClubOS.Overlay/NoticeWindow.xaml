<Window x:Class="ClubOS.Overlay.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClubOS - сообщение администратора"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Сообщение администратора на весь экран: для случая, когда поверх полноэкранной игры маленькое окно не видно. Забирает фокус (игра сворачивается),
         по кнопке «Понятно» исчезает и возвращает гостя в игру. -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Warn}" BorderThickness="2" MaxWidth="980"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Margin="64,56,64,60">
            <Rectangle Width="64" Height="6" Fill="{StaticResource Warn}" HorizontalAlignment="Left" Margin="0,0,0,24"/>
            <TextBlock x:Name="TitleText" Style="{StaticResource Display}" FontSize="36" Foreground="{StaticResource Warn}" Text="Сообщение от администратора"/>
            <TextBlock x:Name="BodyText" FontSize="28" Margin="0,22,0,0" TextWrapping="Wrap"/>
            <Button x:Name="OkButton" Style="{StaticResource Primary}" Content="Понятно" Margin="0,44,0,0" FontSize="20" Width="260" HorizontalAlignment="Left"
                    IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Border>
</Window>
