<UserControl x:Class="ClubOS.Overlay.AttractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}" IsHitTestVisible="False">
    <!-- Заставка: пока на ПК никого нет, на весь экран идёт рекламный баннер, а по нажатию кнопки или клавиши открывается форма входа. DataContext = AttractModel.
         Баннер помещается в экран целиком (Uniform); свободные поля заливаются продолжением его края (если край гладкий), иначе остаются тёмными.
         Два слоя лежат друг на друге: новый проявляется, прежний гаснет. Слой = заливка двух полей + картинка.
         Подпись (РЕКЛАМА, рекламодатель, erid) обязательна по закону: плашка на самом баннере слева внизу. Плашки и заливка плоские, без градиентов. -->
    <Grid>
        <Grid x:Name="LayerA" Opacity="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Image x:Name="FillA1" Stretch="Fill"/>
            <Image x:Name="FillA2" Stretch="Fill"/>
            <Image x:Name="ImageA" Grid.RowSpan="2" Grid.ColumnSpan="2" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
        <Grid x:Name="LayerB" Opacity="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Image x:Name="FillB1" Stretch="Fill"/>
            <Image x:Name="FillB2" Stretch="Fill"/>
            <Image x:Name="ImageB" Grid.RowSpan="2" Grid.ColumnSpan="2" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>

        <!-- Подпись: слева внизу -->
        <Border x:Name="Caption" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="48,0,0,40" Padding="14,7,16,8" Background="#D90B0B0C">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Реклама" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="Meta" Foreground="{StaticResource Text}" FontSize="15" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Точки карусели: по центру внизу, показывают, какой по счёту баннер -->
        <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,52"/>

        <!-- Подсказка: справа внизу -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,48,40" Padding="16,7,16,8" Background="#D90B0B0C">
            <TextBlock Text="Нажмите любую кнопку, чтобы войти" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
