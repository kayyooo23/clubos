<Window x:Class="ClubOS.Overlay.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClubOS - уведомление" Width="400" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        Background="{StaticResource Panel}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        MouseLeftButtonDown="Toast_Click">
    <!-- Короткое предупреждение в углу экрана поверх игры. Не забирает фокус, не закрывает экран, исчезает само или по щелчку. -->
    <Border BorderBrush="{StaticResource Warn}" BorderThickness="2,2,2,2">
        <Grid>
            <Rectangle Width="6" Fill="{StaticResource Warn}" HorizontalAlignment="Left"/>
            <StackPanel Margin="26,16,18,16">
                <TextBlock x:Name="TitleText" Style="{StaticResource Display}" FontSize="20" Foreground="{StaticResource Warn}"/>
                <TextBlock x:Name="BodyText" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
