<Application x:Class="ClubOS.Overlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClubOS.Overlay"
             ShutdownMode="OnExplicitShutdown">
    <!--
      Оформление «чёрный, белый и золото»: тёмная нейтральная основа, белый для главного, золото для мелких деталей.
      Правила, которых держится весь интерфейс:
        • углы только прямые (радиус 0), рамки 2 px;
        • белый = главное действие (главная кнопка, выбранный фильтр), золото = только мелкие детали (полоски, подписи, рамка при наведении и в фокусе); зелёный и янтарный только для состояний;
        • текст на белом и на золоте чёрный (контраст 19.7:1 и 9.4:1), золото на чёрном читается (9.4:1); красный только для ошибок и опасных действий;
        • шрифт Manrope лежит внутри программы (папка Fonts, лицензия OFL), на клубных ПК ничего ставить не нужно; заголовки обычным регистром, а не заглавными;
        • значки Phosphor (Icons.xaml), цвет значка берётся от кнопки, в которой он лежит.
    -->
    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Icons.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="Bg" Color="#0B0B0C"/>
        <SolidColorBrush x:Key="Panel" Color="#131314"/>
        <!-- панель входа на экране блокировки: тот же цвет, но сквозь неё виден фон (около 78% непрозрачности) -->
        <SolidColorBrush x:Key="PanelGlass" Color="#C7131314"/>
        <SolidColorBrush x:Key="Raised" Color="#1A1A1C"/>
        <SolidColorBrush x:Key="Line" Color="#2C2C2F"/>
        <SolidColorBrush x:Key="LineStrong" Color="#46464B"/>
        <SolidColorBrush x:Key="Text" Color="#F3F3F1"/>
        <SolidColorBrush x:Key="Muted" Color="#8E8E93"/>
        <SolidColorBrush x:Key="Accent" Color="#D4AF37"/>
        <SolidColorBrush x:Key="AccentHover" Color="#E6C555"/>
        <SolidColorBrush x:Key="AccentPressed" Color="#B8932A"/>
        <SolidColorBrush x:Key="OnAccent" Color="#0B0B0C"/>
        <!-- главная кнопка и выбранный фильтр: белая заливка, чёрный текст -->
        <SolidColorBrush x:Key="White" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="WhiteHover" Color="#E6E6E3"/>
        <SolidColorBrush x:Key="WhitePressed" Color="#C9C9C5"/>
        <SolidColorBrush x:Key="OnWhite" Color="#0B0B0C"/>
        <SolidColorBrush x:Key="Danger" Color="#E5484D"/>
        <SolidColorBrush x:Key="ErrorText" Color="#FF8A8F"/>
        <SolidColorBrush x:Key="Ok" Color="#3DDC84"/>
        <SolidColorBrush x:Key="Warn" Color="#FF9F43"/>

        <FontFamily x:Key="UiFont">/ClubOS.Overlay;component/Fonts/#Manrope, Segoe UI</FontFamily>
        <local:TextToVisibility x:Key="HasText"/>
        <local:CoverImage x:Key="CoverImage"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- текст внутри кнопки берёт цвет у самой кнопки (иначе общий стиль TextBlock перекрасил бы его в светлый, и на белой кнопке текст не виден) -->
        <Style x:Key="ButtonText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
        </Style>
        <!-- заголовки и цифры: насыщенное начертание, цифры одной ширины -->
        <Style x:Key="Display" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource Display}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="Overline" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- поля ввода: тёмные, рамка 2 px, золотая при фокусе. Серая подсказка (Input.Hint) видна, пока поле пустое -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="{StaticResource Bg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <!-- отступ текста внутри поля даёт сам TextBox (его Padding), поэтому у узла содержимого своего Margin нет: иначе отступ удваивался -->
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                                <TextBlock x:Name="HintText" Text="{Binding (local:Input.Hint), RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource Muted}"
                                           FontSize="{TemplateBinding FontSize}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"
                                           IsHitTestVisible="False" Opacity="0.7" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value=""><Setter TargetName="HintText" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource LineStrong}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- поле без рамки для открытого пароля: лежит внутри поля пароля (его рамку рисует само поле пароля) -->
        <Style x:Key="BarePlain" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Focusable="False"/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- «глазик» справа в поле пароля: нажатый показывает пароль и меняет значок на перечёркнутый глаз -->
        <Style x:Key="EyeToggle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Показать пароль"/>
            <Setter Property="AutomationProperties.Name" Value="Показать пароль"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="46">
                            <Path x:Name="Ico" Data="{StaticResource IconEye}" Width="22" Height="22" Stretch="Uniform" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ico" Property="Data" Value="{StaticResource IconEyeSlash}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="{StaticResource Bg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="local:Input.Reveal" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <!-- отступ текста даёт сам элемент (его Padding), поэтому ни у скрытого пароля, ни у открытого нет своего Margin: высота поля одна и та же в обоих режимах -->
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
                                <TextBox x:Name="PART_Plain" Style="{StaticResource BarePlain}" Padding="{TemplateBinding Padding}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ToggleButton x:Name="PART_Eye" Grid.Column="1" Style="{StaticResource EyeToggle}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource LineStrong}"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,18,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="24" Height="24" BorderThickness="2" BorderBrush="{StaticResource LineStrong}"
                                    Background="{StaticResource Bg}" VerticalAlignment="Top" Margin="0,0,12,0">
                                <Path x:Name="Mark" Data="M 3.5,10 L 8.5,15 L 18,4.5" Stroke="{StaticResource OnAccent}" StrokeThickness="3" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- главная кнопка: белая заливка, чёрный текст, при фокусе золотая рамка -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource OnWhite}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,22,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{StaticResource White}" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource ButtonText}"/></ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource WhiteHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource WhitePressed}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- второстепенная кнопка: рамка без заливки -->
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Transparent" BorderBrush="{StaticResource LineStrong}" BorderThickness="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Raised}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Text}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- контурная кнопка с золотой рамкой: важное действие, когда рядом уже есть главная белая кнопка -->
        <Style x:Key="AccentOutline" TargetType="Button" BasedOn="{StaticResource Secondary}">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Transparent" BorderBrush="{StaticResource Accent}" BorderThickness="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource ButtonText}"/></ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Raised}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentPressed}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Text}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- текстовая кнопка-ссылка -->
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="2,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Text}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- карточка тарифа -->
        <Style x:Key="TariffCard" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="2" Padding="16,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Raised}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.65"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- пункт выезжающего меню: значок (Tag) и подпись, выбранный с золотой полосой слева -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="Transparent" BorderBrush="Transparent" BorderThickness="4,0,0,0" Height="54" Padding="22,0,16,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Path Data="{TemplateBinding Tag}" Width="22" Height="22" Stretch="Uniform" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource ButtonText}"/></ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Text}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Raised}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- значок: заливка берёт цвет текста ближайшей кнопки (в других местах Fill задаётся явно) -->
        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        </Style>

        <!-- плитка действия в правой колонке: значок сверху, короткая подпись под ним. Значок задаётся в Tag, полное название в ToolTip -->
        <Style x:Key="ActionTile" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Padding="6,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="{TemplateBinding Tag}" Width="24" Height="24" Stretch="Uniform" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}" Margin="0,9,0,0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionTilePrimary" TargetType="Button" BasedOn="{StaticResource ActionTile}">
            <Setter Property="Foreground" Value="{StaticResource OnWhite}"/>
            <Setter Property="Background" Value="{StaticResource White}"/>
            <Setter Property="BorderBrush" Value="{StaticResource White}"/>
        </Style>
        <Style x:Key="ActionTileAccent" TargetType="Button" BasedOn="{StaticResource ActionTile}">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>

        <!-- фильтр по категории: выбранный залит белым, при наведении золотая рамка (DataContext кнопки = CategoryChip) -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Transparent" BorderBrush="{StaticResource LineStrong}" BorderThickness="2" Padding="16,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource ButtonText}"/></ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Text}"/></Trigger>
                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource White}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource White}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnWhite}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- игра в библиотеке: вертикальный постер, под ним название (DataContext = AppCard). Размер задаёт сетка UniformWrapPanel.
             Нет обложки: плитка с большой буквой. Игра не установлена: приглушена. При наведении золотая рамка и белая плашка «ЗАПУСТИТЬ». -->
        <Style x:Key="GameTile" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border x:Name="Poster" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="2" ClipToBounds="True">
                                <Grid>
                                    <Grid x:Name="Placeholder">
                                        <TextBlock Text="{Binding Initial}" Style="{StaticResource Display}" FontSize="84" Foreground="{StaticResource Raised}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource Muted}" FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,52,0" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Image x:Name="Cover" Source="{Binding CoverPath, Converter={StaticResource CoverImage}}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="7,2" Background="#D90B0B0C"
                                            Visibility="{Binding AgeText, Converter={StaticResource HasText}}">
                                        <TextBlock Text="{Binding AgeText}" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border x:Name="Play" Visibility="Collapsed" VerticalAlignment="Bottom" Background="{StaticResource White}" Padding="0,9">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconPlay}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource OnWhite}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Запустить" Foreground="{StaticResource OnWhite}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Display}" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Warn}" FontSize="13" Margin="0,2,0,0"
                                           Visibility="{Binding Hint, Converter={StaticResource HasText}}"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasCover}" Value="True"><Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Poster" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Play" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Poster" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Play" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Poster" Property="Background" Value="{StaticResource Raised}"/></Trigger>
                            <DataTrigger Binding="{Binding Available}" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5"/></DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- программа в библиотеке: компактная плитка с иконкой (или буквой, пока иконки нет) и названием (DataContext = AppCard) -->
        <Style x:Key="ProgramTile" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="2">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource Raised}">
                                    <Grid>
                                        <TextBlock x:Name="Letter" Text="{Binding Initial}" Style="{StaticResource Display}" FontSize="22" Foreground="{StaticResource Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <!-- иконка программы (её присылает ПК, где программу выбрали): целиком и с запасом по краям, без обрезки -->
                                        <Image Source="{Binding CoverPath, Converter={StaticResource CoverImage}}" Stretch="Uniform" Margin="9"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,12,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Display}" FontSize="16" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Warn}" FontSize="13"
                                               Visibility="{Binding Hint, Converter={StaticResource HasText}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Raised}"/></Trigger>
                            <DataTrigger Binding="{Binding Available}" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.5"/></DataTrigger>
                            <DataTrigger Binding="{Binding HasCover}" Value="True"><Setter TargetName="Letter" Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- индикатор состояния «идёт сессия»: круг мигает (плавно гаснет и загорается), вокруг него расходится лёгкая волна. Без градиентов и поворотов,
             только прозрачность и размер. Зелёный, при доплате по часам оранжевый (DataContext = модель меню) -->
        <Style x:Key="StatusShape" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource Ok}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers><DataTrigger Binding="{Binding Flow.IsOvertime}" Value="True"><Setter Property="Fill" Value="{StaticResource Warn}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse" BasedOn="{StaticResource StatusShape}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusHalo" TargetType="Ellipse" BasedOn="{StaticResource StatusShape}">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Opacity" Value="0.35"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="Width" From="14" To="30" Duration="0:0:1.6"/>
                            <DoubleAnimation Storyboard.TargetProperty="Height" From="14" To="30" Duration="0:0:1.6"/>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0" Duration="0:0:1.6"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- товар в баре: название, цена, сколько уже в корзине (DataContext = ProductCard); нажатие добавляет одну штуку -->
        <Style x:Key="ProductTile" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="224"/>
            <Setter Property="Height" Value="124"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="2">
                            <Grid Margin="16,12,16,14">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" HorizontalAlignment="Left" Margin="0,0,56,0"/>
                                    <Border x:Name="QtyBadge" Background="{StaticResource Accent}" Padding="8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                                        <TextBlock Foreground="{StaticResource OnAccent}" FontSize="14" FontWeight="Bold">
                                            <Run Text="x "/><Run Text="{Binding Qty, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource Display}" FontSize="18" TextWrapping="Wrap" MaxHeight="48"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Text="{Binding PriceText}" Style="{StaticResource Display}" FontSize="22" Foreground="{StaticResource Text}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Raised}"/></Trigger>
                            <DataTrigger Binding="{Binding InCart}" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="QtyBadge" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- маленькая квадратная кнопка + / - в корзине -->
        <Style x:Key="Step" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Transparent" BorderBrush="{StaticResource LineStrong}" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Raised}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </Application.Resources>
</Application>
