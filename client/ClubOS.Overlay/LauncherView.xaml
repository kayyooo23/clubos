<UserControl x:Class="ClubOS.Overlay.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClubOS.Overlay"
             UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="{StaticResource UiFont}"
             PreviewMouseMove="View_Input" PreviewMouseDown="View_Input" PreviewKeyDown="View_Input">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:Money x:Key="Money"/>
        <local:NoTextToVisibility x:Key="NoText"/>
        <local:InvertBoolToVisibility x:Key="Invert"/>
        <!-- карточка тарифа: до сессии начинает её, во время сессии продлевает (решает Tariff_Click) -->
        <DataTemplate x:Key="TariffTemplate">
            <Button Style="{StaticResource TariffCard}" Tag="{Binding Id}" IsEnabled="{Binding CanStart}" Click="Tariff_Click"
                    Width="420" Margin="0,0,16,16" AutomationProperties.Name="{Binding Name}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Display}" FontSize="20"/>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Warn}" FontSize="13" Margin="0,4,0,0"
                                   Visibility="{Binding Hint, Converter={StaticResource HasText}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding PriceText}" Style="{StaticResource Display}" FontSize="22"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- DataContext = LauncherModel. Слева узкая ручка выезжающего меню, в центре содержимое, справа время, баланс и действия. -->
    <Grid Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ЦЕНТР: заголовок, поиск и содержимое вкладки -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,28,36,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Display}" FontSize="30" VerticalAlignment="Center"/>
                    <Grid Width="300" Margin="28,2,0,0" VerticalAlignment="Center" Visibility="{Binding ShowSearch, Converter={StaticResource BoolToVis}}">
                        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="40,9,12,9" MaxLength="60"/>
                        <Path Data="{StaticResource IconSearch}" Style="{StaticResource Icon}" Width="18" Height="18" Fill="{StaticResource Muted}"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0"/>
                        <TextBlock Text="Поиск" Foreground="{StaticResource Muted}" FontSize="15" Margin="42,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Search, Converter={StaticResource NoText}}"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Chips}" Margin="28,20,36,0" Visibility="{Binding ShowBar, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Chip}" Content="{Binding Title}" Tag="{Binding Key}" Click="Chip_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- БИБЛИОТЕКА: сверху игры, ниже под линией программы (категорий нет). Поиск работает по обоим разделам, раздел без совпадений скрывается. -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Background="{StaticResource Bg}"
                          Visibility="{Binding ShowCatalog, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="28,10,20,24">
                    <StackPanel Visibility="{Binding ShowGames, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,16,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Игры" Style="{StaticResource Display}" FontSize="20"/>
                                <TextBlock Text="{Binding GameCards.Count}" Foreground="{StaticResource Muted}" FontSize="14" FontWeight="SemiBold" Margin="10,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Height="2" Fill="{StaticResource Line}" Margin="20,3,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding GameCards}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:UniformWrapPanel MinItemWidth="170" HeightPerWidth="1.5" ExtraHeight="48"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GameTile}" Click="App_Click" AutomationProperties.Name="{Binding Title}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowApps, Converter={StaticResource BoolToVis}}" Margin="0,18,0,0">
                        <Grid Margin="0,0,16,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Программы" Style="{StaticResource Display}" FontSize="20"/>
                                <TextBlock Text="{Binding AppCards.Count}" Foreground="{StaticResource Muted}" FontSize="14" FontWeight="SemiBold" Margin="10,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Height="2" Fill="{StaticResource LineStrong}" Margin="20,3,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding AppCards}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:UniformWrapPanel MinItemWidth="240" FixedHeight="64"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ProgramTile}" Click="App_Click" AutomationProperties.Name="{Binding Title}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource Muted}" FontSize="16" Margin="0,24,0,0"
                               Visibility="{Binding EmptyText, Converter={StaticResource HasText}}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- БАР: меню; заказ собирается в корзине справа -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Background="{StaticResource Bg}"
                          Visibility="{Binding ShowBar, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="28,10,20,24">
                    <ItemsControl ItemsSource="{Binding ProductCards}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ProductTile}" Click="Product_Click" AutomationProperties.Name="{Binding Name}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding BarEmptyText}" Foreground="{StaticResource Muted}" FontSize="16" Margin="0,24,0,0"
                               Visibility="{Binding BarEmptyText, Converter={StaticResource HasText}}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ТАРИФЫ: до начала сессии выбор тарифа; во время сессии («Продление») покупка пакета, время которого добавляется к оставшемуся -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Background="{StaticResource Bg}"
                          Visibility="{Binding IsTariffsPage, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="28,10,36,24">
                    <StackPanel Visibility="{Binding CanLogout, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Оплата списывается с вашего баланса. Выберите, как будете играть." Style="{StaticResource Hint}" FontSize="15" Margin="0,0,0,20"/>
                        <ItemsControl ItemsSource="{Binding Flow.Tariffs}" ItemTemplate="{StaticResource TariffTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Visibility="{Binding CanExtend, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Выберите пакет: время добавится к тому, что осталось. Оплата спишется с баланса сразу." Style="{StaticResource Hint}" FontSize="15" Margin="0,0,0,20"/>
                        <ItemsControl ItemsSource="{Binding Flow.ExtendTariffs}" ItemTemplate="{StaticResource TariffTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="Сессия идёт. Новый тариф можно выбрать после её завершения." Style="{StaticResource Hint}" FontSize="15"
                               Visibility="{Binding ShowNoExtendHint, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ПРАВАЯ КОЛОНКА: время, баланс и действия плитками со значками -->
        <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="2,0,0,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Background="{StaticResource Panel}">
                <StackPanel Margin="28,28,28,24">
                    <Border Margin="0,0,0,20" Padding="12,8" BorderBrush="{StaticResource Warn}" BorderThickness="2"
                            Visibility="{Binding Flow.Banner, Converter={StaticResource HasText}}">
                        <TextBlock Text="{Binding Flow.Banner}" Foreground="{StaticResource Warn}" FontSize="14"/>
                    </Border>

                    <!-- гость -->
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconUser}" Style="{StaticResource Icon}" Width="22" Height="22" Fill="{StaticResource Muted}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Flow.CabinetPhone}" Foreground="{StaticResource Muted}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- ВРЕМЯ: пока идёт сессия, сколько осталось (цвет по остатку, см. код). Пояснение про доплату по часам спрятано в подсказку у значка -->
                    <StackPanel Margin="0,26,0,0" Visibility="{Binding Flow.HasSession, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTime}" Style="{StaticResource Icon}" Width="16" Height="16" Fill="{StaticResource Accent}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Flow.ClockLabel}" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="HeaderClock" Text="{Binding Flow.SessionClock}" Style="{StaticResource Display}" FontSize="52" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Flow.SessionTitle}" Foreground="{StaticResource Muted}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Border Margin="8,0,0,0" Background="Transparent" ToolTip="{Binding Flow.SessionNote}" VerticalAlignment="Center"
                                    Visibility="{Binding Flow.SessionNote, Converter={StaticResource HasText}}">
                                <Path Data="{StaticResource IconInfo}" Style="{StaticResource Icon}" Width="16" Height="16" Fill="{StaticResource Muted}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Height="2" Fill="{StaticResource Line}" Margin="0,22,0,20"/>

                    <!-- БАЛАНС -->
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconWallet}" Style="{StaticResource Icon}" Width="16" Height="16" Fill="{StaticResource Accent}" Margin="0,0,8,0"/>
                        <TextBlock Text="Баланс" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Flow.Balance, Converter={StaticResource Money}}" Style="{StaticResource Display}" FontSize="30" Margin="0,4,0,0"/>

                    <!-- БАР: корзина и мои заказы (только на вкладке «Бар») -->
                    <StackPanel Visibility="{Binding ShowBar, Converter={StaticResource BoolToVis}}" Margin="0,18,0,0">
                        <Rectangle Height="2" Fill="{StaticResource Line}" Margin="0,0,0,20"/>
                        <TextBlock Text="Ваш заказ" Style="{StaticResource Overline}"/>
                        <TextBlock Text="Выберите товары слева" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,8,0,0"
                                   Visibility="{Binding Bar.HasCart, Converter={StaticResource Invert}}"/>
                        <ItemsControl ItemsSource="{Binding Bar.Cart}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Foreground="{StaticResource Muted}" FontSize="13">
                                                <Run Text="{Binding Qty, Mode=OneWay}"/><Run Text=" шт, "/><Run Text="{Binding SumText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource Step}" Tag="{Binding Id}" Click="CartMinus_Click" AutomationProperties.Name="Убрать">
                                            <Path Data="{StaticResource IconMinus}" Style="{StaticResource Icon}" Width="14" Height="14"/>
                                        </Button>
                                        <Button Grid.Column="3" Style="{StaticResource Step}" Tag="{Binding Id}" Click="CartPlus_Click" AutomationProperties.Name="Добавить">
                                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource Icon}" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,16,0,0" Visibility="{Binding Bar.HasCart, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Итого" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Bar.TotalText}" Style="{StaticResource Display}" FontSize="26" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding Bar.CartHint}" Foreground="{StaticResource Warn}" FontSize="13" Margin="0,4,0,0"
                                   Visibility="{Binding Bar.CartHint, Converter={StaticResource HasText}}"/>
                        <Button Content="Заказать" Style="{StaticResource Primary}" Margin="0,14,0,0" Click="Order_Click" IsEnabled="{Binding Bar.CanOrder}"
                                Visibility="{Binding Bar.HasCart, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="Оплата спишется с баланса. Принесём к вашему месту." Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"
                                   Visibility="{Binding Bar.HasCart, Converter={StaticResource BoolToVis}}"/>

                        <StackPanel Visibility="{Binding Bar.HasOrders, Converter={StaticResource BoolToVis}}" Margin="0,18,0,0">
                            <TextBlock Text="Мои заказы" Style="{StaticResource Overline}"/>
                            <ItemsControl ItemsSource="{Binding Bar.Orders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,8,0,0" Padding="12,8" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="2">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,90,0"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Warn}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"/>
                                                <Button Content="Отменить заказ" Style="{StaticResource Link}" HorizontalAlignment="Left" Tag="{Binding Id}" Click="CancelOrder_Click"
                                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- ДЕЙСТВИЯ: плитки со значками, доступны на любой вкладке. Полное название в подсказке -->
                    <local:UniformWrapPanel MinItemWidth="110" Gap="12" FixedHeight="88" Margin="0,24,0,0">
                        <Button Content="Продлить" Style="{StaticResource ActionTilePrimary}" Tag="{StaticResource IconExtend}" ToolTip="Продлить тариф"
                                AutomationProperties.Name="Продлить тариф" Click="Extend_Click"
                                Visibility="{Binding ExtendIsPrimary, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Продлить" Style="{StaticResource ActionTileAccent}" Tag="{StaticResource IconExtend}" ToolTip="Продлить тариф"
                                AutomationProperties.Name="Продлить тариф" Click="Extend_Click"
                                Visibility="{Binding ExtendIsOutline, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Пополнить" Style="{StaticResource ActionTile}" Tag="{StaticResource IconWallet}" ToolTip="Пополнить баланс"
                                AutomationProperties.Name="Пополнить баланс" Click="TopUp_Click" IsEnabled="{Binding Bar.CanCall}"/>
                        <Button Content="{Binding Bar.CallShortText}" Style="{StaticResource ActionTile}" Tag="{StaticResource IconAdmin}" ToolTip="{Binding Bar.CallButtonText}"
                                AutomationProperties.Name="{Binding Bar.CallButtonText}" Click="Call_Click" IsEnabled="{Binding Bar.CanCall}"/>
                        <Button Content="Завершить" Style="{StaticResource ActionTile}" Tag="{StaticResource IconPower}" ToolTip="Завершить сессию"
                                AutomationProperties.Name="Завершить сессию" Click="Stop_Click" IsEnabled="{Binding Flow.CanInteract}"
                                Visibility="{Binding Flow.HasSession, Converter={StaticResource BoolToVis}}"/>
                    </local:UniformWrapPanel>

                    <Border Margin="0,16,0,0" Padding="14,10" Background="{StaticResource Bg}" BorderBrush="{StaticResource Ok}" BorderThickness="4,0,0,0"
                            Visibility="{Binding Notice, Converter={StaticResource HasText}}">
                        <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Text}" FontSize="14"/>
                    </Border>
                    <Border Margin="0,16,0,0" Padding="14,10" Background="{StaticResource Bg}" BorderBrush="{StaticResource Danger}" BorderThickness="4,0,0,0"
                            Visibility="{Binding Bar.Error, Converter={StaticResource HasText}}">
                        <TextBlock Text="{Binding Bar.Error}" Foreground="{StaticResource ErrorText}" FontSize="14"/>
                    </Border>
                    <Border Margin="0,16,0,0" Padding="14,10" Background="{StaticResource Bg}" BorderBrush="{StaticResource Ok}" BorderThickness="4,0,0,0"
                            Visibility="{Binding Bar.Note, Converter={StaticResource HasText}}">
                        <TextBlock Text="{Binding Bar.Note}" Foreground="{StaticResource Text}" FontSize="14"/>
                    </Border>

                    <Border Margin="0,16,0,0" Padding="14,10" Background="{StaticResource Bg}" BorderBrush="{StaticResource Danger}" BorderThickness="4,0,0,0"
                            Visibility="{Binding Flow.Error, Converter={StaticResource HasText}}">
                        <TextBlock Text="{Binding Flow.Error}" Foreground="{StaticResource ErrorText}" FontSize="14"/>
                    </Border>
                    <Border Margin="0,16,0,0" Padding="14,10" Background="{StaticResource Bg}" BorderBrush="{StaticResource Danger}" BorderThickness="4,0,0,0"
                            Visibility="{Binding LaunchError, Converter={StaticResource HasText}}">
                        <TextBlock Text="{Binding LaunchError}" Foreground="{StaticResource ErrorText}" FontSize="14"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- СТАТУС ВНИЗУ КОЛОНКИ: круглый индикатор и подпись (идёт сессия / тариф закончился / сессия не начата) -->
            <Border Grid.Row="1" Padding="28,18,28,20" BorderBrush="{StaticResource Line}" BorderThickness="0,2,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Flow.HasSession}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            <DataTrigger Binding="{Binding CanLogout}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <StackPanel x:Name="SessionStatusRow" Orientation="Horizontal" Visibility="{Binding Flow.HasSession, Converter={StaticResource BoolToVis}}">
                        <!-- поле 32 x 32 с обратным отступом: расходящаяся волна (до 30 px) целиком помещается и не обрезается по краям квадратом, а занимаемое место прежнее (20 + 12) -->
                        <Grid Width="32" Height="32" VerticalAlignment="Center" Margin="-6,-6,6,-6">
                            <Ellipse Style="{StaticResource StatusHalo}"/>
                            <Ellipse Style="{StaticResource StatusDot}"/>
                        </Grid>
                        <TextBlock x:Name="SessionStatusText" Text="{Binding Flow.SessionStatus}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{StaticResource Ok}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Flow.IsOvertime}" Value="True"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel x:Name="NoSessionStatusRow" Orientation="Horizontal" Visibility="{Binding CanLogout, Converter={StaticResource BoolToVis}}">
                        <Grid Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Ellipse Width="20" Height="20" Fill="{StaticResource Warn}" Opacity="0.25"/>
                            <Ellipse Width="10" Height="10" Fill="{StaticResource Warn}"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Сессия не начата" Foreground="{StaticResource Warn}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Выберите тариф" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
          </Grid>
        </Border>

        <!-- ВЫЕЗЖАЮЩЕЕ МЕНЮ: в покое узкая ручка со стрелкой, при наведении мыши выезжает поверх содержимого и показывает вкладки -->
        <Border x:Name="NavDrawer" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Panel.ZIndex="10" ClipToBounds="True"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,2,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="34"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="276" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="34" BeginTime="0:0:0.3" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <!-- стрелка-подсказка: пока меню свёрнуто, видна по центру ручки -->
                <Path Data="{StaticResource IconArrow}" Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource Muted}"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"><Setter Property="Opacity" Value="0"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <!-- содержимое меню шириной 276 всегда: при выезде оно открывается, а не переносится по строкам -->
                <Grid Width="276" HorizontalAlignment="Left">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="26,30,20,22">
                        <Rectangle Width="44" Height="6" Fill="{StaticResource Accent}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                        <TextBlock Text="{Binding Flow.ClubTitle}" Style="{StaticResource Display}" FontSize="22" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Flow.PcLabel}" Foreground="{StaticResource Muted}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Visibility="{Binding Flow.PcLabel, Converter={StaticResource HasText}}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <RadioButton Style="{StaticResource NavItem}" Content="Библиотека" Tag="{StaticResource IconGame}" IsChecked="{Binding IsLibraryPage, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="Бар" Tag="{StaticResource IconBar}" IsChecked="{Binding IsBarPage, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource NavItem}" Content="{Binding TariffsTitle}" Tag="{StaticResource IconExtend}" IsChecked="{Binding IsTariffsPage, Mode=TwoWay}"
                                     Visibility="{Binding ShowTariffsTab, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="22,0,20,22">
                        <Button Content="Выйти из кабинета" Style="{StaticResource Link}" HorizontalAlignment="Left" Click="Logout_Click"
                                Visibility="{Binding CanLogout, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
