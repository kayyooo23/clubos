<Window x:Class="ClubOS.Overlay.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClubOS" Width="540" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Вопрос «точно?» в стиле остального интерфейса вместо системного окна Windows: тёмная панель, золотая полоска, две понятные кнопки
         (главная белая, вторая контурная). Esc отвечает «нет». -->
    <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="2">
        <StackPanel Margin="36,32,36,34">
            <Rectangle Width="44" Height="6" Fill="{StaticResource Accent}" HorizontalAlignment="Left" Margin="0,0,0,18"/>
            <TextBlock x:Name="TitleText" Style="{StaticResource Display}" FontSize="24"/>
            <TextBlock x:Name="MessageText" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <Grid Margin="0,30,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="YesButton" Style="{StaticResource Primary}" Margin="0" FontSize="15" Click="Yes_Click"/>
                <Button x:Name="NoButton" Grid.Column="2" Style="{StaticResource Secondary}" Margin="0" FontSize="15" Click="No_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
