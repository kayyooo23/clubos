<Window x:Class="ClubOS.Overlay.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClubOS.Overlay"
        Title="ClubOS" Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseMove="Window_Move" PreviewMouseDown="Window_Down">
    <Window.Resources>
        <local:EqualsToVisibility x:Key="Is"/>
        <local:TextToVisibility x:Key="HasText"/>
        <local:ResendText x:Key="ResendText"/>
        <local:ZeroToTrue x:Key="Zero"/>
        <local:Money x:Key="Money"/>
        <local:NotEqualsToVisibility x:Key="IsNot"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
      <!-- ВХОД, РЕГИСТРАЦИЯ, СБРОС ПАРОЛЯ. Когда гость вошёл (Screen = Cabinet), вместо них показывается меню. -->
      <Grid x:Name="AuthGrid" Visibility="{Binding Screen, Converter={StaticResource IsNot}, ConverterParameter=Cabinet}">

        <!-- ФОН НА ВСЁ ОКНО: вложенные круги с лёгкой золотой заливкой по центру, за карточкой входа. Сквозь полупрозрачную карточку они чуть просвечивают. -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <!-- концентрические кольца: простая фигура, которая чисто рисуется на любом размере -->
            <Ellipse Width="720" Height="720" Fill="#0CD4AF37" Stroke="#1AFFFFFF" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="1120" Height="1120" Fill="#08D4AF37" Stroke="#12FFFFFF" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="1560" Height="1560" Fill="#05D4AF37" Stroke="#0CFFFFFF" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- ЛЕВЫЙ ВЕРХНИЙ УГОЛ: только состояние и номер ПК. Название клуба здесь не нужно: гость сидит в своём клубе. -->
        <StackPanel x:Name="Identity" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,56,40,32">
            <Rectangle Width="64" Height="6" Fill="{StaticResource Accent}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
            <TextBlock Text="ПК заблокирован" Style="{StaticResource Display}" FontSize="28" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="{Binding PcLabel}" Style="{StaticResource Display}" FontSize="22" Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                       Visibility="{Binding PcLabel, Converter={StaticResource HasText}}"/>
        </StackPanel>

        <!-- ВХОД, РЕГИСТРАЦИЯ, СБРОС ПАРОЛЯ: отдельная рамка по центру окна. Если высоты не хватает, карточка целиком уменьшается (не прокручивается),
             чтобы кнопка действия всегда оставалась на экране. -->
        <Viewbox x:Name="LoginBox" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <Border x:Name="LoginPanel" Width="484" Background="{StaticResource PanelGlass}" BorderBrush="{StaticResource LineStrong}" BorderThickness="2" Padding="40,36">
                <StackPanel>
                    <Border Margin="0,0,0,22" Padding="14,10" BorderBrush="{StaticResource Warn}" BorderThickness="2"
                            Visibility="{Binding Banner, Converter={StaticResource HasText}}">
                        <TextBlock Text="{Binding Banner}" Foreground="{StaticResource Warn}" FontSize="14"/>
                    </Border>

                    <StackPanel Width="400">

                        <!-- ВХОД -->
                        <StackPanel Visibility="{Binding Screen, Converter={StaticResource Is}, ConverterParameter=Login}">
                            <TextBlock Text="Вход" Style="{StaticResource Title}"/>
                            <TextBlock Text="Войдите, чтобы начать играть" Style="{StaticResource Hint}"/>
                            <TextBlock Text="Телефон" Style="{StaticResource Label}"/>
                            <TextBox x:Name="LoginPhone" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" local:Input.Mask="Phone" local:Input.Hint="+7 (000) 000-00-00"/>
                            <TextBlock Text="Пароль" Style="{StaticResource Label}"/>
                            <PasswordBox x:Name="PwdLogin" Tag="1" PasswordChanged="Password_Changed"/>
                            <Button Content="Войти" Style="{StaticResource Primary}" Click="Login_Click" IsEnabled="{Binding CanInteract}"/>
                            <Grid Margin="0,14,0,0">
                                <Button Content="Регистрация" Style="{StaticResource Link}" HorizontalAlignment="Left" Click="ToRegister_Click"/>
                                <Button Content="Забыли пароль?" Style="{StaticResource Link}" HorizontalAlignment="Right" Click="ToReset_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- РЕГИСТРАЦИЯ: телефон -->
                        <StackPanel Visibility="{Binding Screen, Converter={StaticResource Is}, ConverterParameter=RegisterPhone}">
                            <TextBlock Text="Регистрация" Style="{StaticResource Title}"/>
                            <TextBlock Text="Укажите номер телефона. Мы отправим код подтверждения в SMS." Style="{StaticResource Hint}"/>
                            <TextBlock Text="Телефон" Style="{StaticResource Label}"/>
                            <TextBox x:Name="RegPhone" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" local:Input.Mask="Phone" local:Input.Hint="+7 (000) 000-00-00"/>
                            <Button Content="Получить код" Style="{StaticResource Primary}" Click="GetCode_Click" IsEnabled="{Binding CanInteract}"/>
                            <Button Content="Назад ко входу" Style="{StaticResource Link}" Margin="0,14,0,0" HorizontalAlignment="Left" Click="BackToLogin_Click"/>
                        </StackPanel>

                        <!-- РЕГИСТРАЦИЯ: код и пароль -->
                        <StackPanel Visibility="{Binding Screen, Converter={StaticResource Is}, ConverterParameter=RegisterConfirm}">
                            <TextBlock Text="Подтверждение" Style="{StaticResource Title}"/>
                            <TextBlock Text="Введите код из SMS и придумайте пароль" Style="{StaticResource Hint}"/>
                            <TextBlock Text="Телефон" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" local:Input.Mask="Phone" local:Input.Hint="+7 (000) 000-00-00"/>
                            <TextBlock Text="Код из SMS" Style="{StaticResource Label}"/>
                            <TextBox x:Name="RegCode" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" local:Input.Mask="Digits" local:Input.Hint="6 цифр"/>
                            <TextBlock Text="Пароль (минимум 8 символов)" Style="{StaticResource Label}"/>
                            <PasswordBox x:Name="PwdReg1" Tag="1" PasswordChanged="Password_Changed"/>
                            <TextBlock Text="Повторите пароль" Style="{StaticResource Label}"/>
                            <PasswordBox x:Name="PwdReg2" Tag="2" PasswordChanged="Password_Changed"/>
                            <CheckBox IsChecked="{Binding AcceptTerms}">
                                <TextBlock Text="Согласен на обработку персональных данных" FontSize="14"/>
                            </CheckBox>
                            <Button Content="Зарегистрироваться" Style="{StaticResource Primary}" Click="Confirm_Click" IsEnabled="{Binding CanInteract}"/>
                            <Grid Margin="0,14,0,0">
                                <Button Style="{StaticResource Link}" HorizontalAlignment="Left" Click="GetCode_Click"
                                        Content="{Binding ResendSecondsLeft, Converter={StaticResource ResendText}}"
                                        IsEnabled="{Binding ResendSecondsLeft, Converter={StaticResource Zero}}"/>
                                <Button Content="Назад" Style="{StaticResource Link}" HorizontalAlignment="Right" Click="BackToLogin_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- СБРОС ПАРОЛЯ: телефон -->
                        <StackPanel Visibility="{Binding Screen, Converter={StaticResource Is}, ConverterParameter=ResetPhone}">
                            <TextBlock Text="Сброс пароля" Style="{StaticResource Title}"/>
                            <TextBlock Text="Отправим код в SMS на номер, указанный при регистрации" Style="{StaticResource Hint}"/>
                            <TextBlock Text="Телефон" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <TextBox x:Name="ResetPhone" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" local:Input.Mask="Phone" local:Input.Hint="+7 (000) 000-00-00"/>
                            <Button Content="Получить код" Style="{StaticResource Primary}" Click="GetCode_Click" IsEnabled="{Binding CanInteract}"/>
                            <Button Content="Назад ко входу" Style="{StaticResource Link}" Margin="0,14,0,0" HorizontalAlignment="Left" Click="BackToLogin_Click"/>
                        </StackPanel>

                        <!-- СБРОС ПАРОЛЯ: код и новый пароль -->
                        <StackPanel Visibility="{Binding Screen, Converter={StaticResource Is}, ConverterParameter=ResetConfirm}">
                            <TextBlock Text="Новый пароль" Style="{StaticResource Title}"/>
                            <TextBlock Text="Введите код из SMS и новый пароль" Style="{StaticResource Hint}"/>
                            <TextBlock Text="Код из SMS" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <TextBox x:Name="ResetCode" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" local:Input.Mask="Digits" local:Input.Hint="6 цифр"/>
                            <TextBlock Text="НОВЫЙ ПАРОЛЬ (МИНИМУМ 8 СИМВОЛОВ)" Style="{StaticResource Label}"/>
                            <PasswordBox x:Name="PwdReset1" Tag="1" PasswordChanged="Password_Changed"/>
                            <TextBlock Text="Повторите пароль" Style="{StaticResource Label}"/>
                            <PasswordBox x:Name="PwdReset2" Tag="2" PasswordChanged="Password_Changed"/>
                            <Button Content="Сменить пароль" Style="{StaticResource Primary}" Click="Confirm_Click" IsEnabled="{Binding CanInteract}"/>
                            <Grid Margin="0,14,0,0">
                                <Button Style="{StaticResource Link}" HorizontalAlignment="Left" Click="GetCode_Click"
                                        Content="{Binding ResendSecondsLeft, Converter={StaticResource ResendText}}"
                                        IsEnabled="{Binding ResendSecondsLeft, Converter={StaticResource Zero}}"/>
                                <Button Content="Назад" Style="{StaticResource Link}" HorizontalAlignment="Right" Click="BackToLogin_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Сообщения -->
                        <Border Margin="0,20,0,0" Padding="14,10" Background="{StaticResource Bg}" BorderBrush="{StaticResource Danger}" BorderThickness="4,0,0,0"
                                Visibility="{Binding Error, Converter={StaticResource HasText}}">
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorText}" FontSize="15"/>
                        </Border>
                        <TextBlock Text="{Binding Info}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,18,0,0"
                                   Visibility="{Binding Info, Converter={StaticResource HasText}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Viewbox>

      </Grid>

      <!-- МЕНЮ ГОСТЯ: гость вошёл, но сессию ещё не начал (ПК остаётся закрытым, пока он не выберет тариф) -->
      <!-- DataContext у меню свой (LauncherModel), поэтому экран берём через его Flow; привязка на Screen напрямую не находила бы источник, и меню всегда было бы видно -->
      <local:LauncherView x:Name="Launcher" Visibility="{Binding Flow.Screen, Converter={StaticResource Is}, ConverterParameter=Cabinet}"/>

      <!-- ЗАСТАВКА: пока на ПК никого нет, поверх всего (кроме нескольких секунд после нажатия) идёт рекламный баннер на весь экран.
           Нажатие кнопки или клавиши убирает её, и видна форма входа. DataContext у заставки свой (AttractModel), Visibility привязана к нему же. -->
      <local:AttractView x:Name="Attract" Visibility="{Binding IsAttract, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>
