# Скопируйте в файл .env рядом с docker-compose.yml и заполните. Файл .env в репозиторий не кладите.
# Адрес, по которому будет доступен сервер (запись A в DNS должна указывать на этот сервер)
DOMAIN=clubos.example.com
# Пароль базы: длинный случайный, например: openssl rand -base64 32
DB_PASSWORD=
# Ключ платформы: даёт доступ ко всем клубам (панель /platform/). Длинный случайный, не передавайте никому: openssl rand -base64 32
PLATFORM_KEY=
# Боевой режим. Он требует настоящего SMS-провайдера (CLUB_SMS_PROVIDER не console): без него сервер намеренно не стартует.
CLUB_ENV=prod
SMS_PROVIDER=console
